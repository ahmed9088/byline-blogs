# --- DATABASE CONFIGURATION ---
# Replace with your actual Supabase URL and Service Role Key:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- BACKEND EXPRESS SERVER CONFIGURATION ---
PORT=5000
NODE_ENV=production
# Replace with a secure random secret key:
JWT_SECRET=your_jwt_secret_key_here

# --- FRONTEND NEXT.JS CONFIGURATION ---
# Leave blank on Vercel to automatically resolve to the dynamic deployment URL:
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_API_URL=/api/backend
